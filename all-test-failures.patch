+def send_ignored_test_failures(pkg: "spack.package_base.PackageBase", state_pipe) -> None:
+    """If test failures were tolerated (``--allow-test-failures``), warn the parent process."""
+    if not (pkg.run_tests and pkg.allow_test_failures):
+        return
+    tester = pkg.tester
+    if not tester or not tester.test_failures:
+        return
+    num = len(tester.test_failures)
+    send_warning(
+        f"{pkg.spec.cformat('{name}{@version}')}: {num} test failure(s) ignored "
+        f"(--allow-test-failures). See test results at: {tester.test_log_file}",
+        state_pipe,
+    )
