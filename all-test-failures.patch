+def _phase_tester(monkeypatch):
+    """A PackageTest with just enough state to run ``phase_tests``."""
+    tester = spack.install_test.PackageTest.__new__(spack.install_test.PackageTest)
+    tester.test_failures = []
+    logger = mock.Mock()
+    logger.force_echo.side_effect = contextlib.nullcontext
+    monkeypatch.setattr(
+        tester, "test_logger", lambda **kwargs: contextlib.nullcontext(logger), raising=False
+    )
+    tester.test_log_file = "/path/to/test-log.txt"
+    return tester
+
+
+def _phase_builder(callback, allow_test_failures):
+    builder = mock.Mock()
+    builder.pkg.allow_test_failures = allow_test_failures
+    builder.check = callback
+    return builder
+
+
+def _failing_check():
+    raise spack.util.executable.ProcessError("Command exited with status 2: make test")
+
+
+@pytest.mark.parametrize("phase", ["build", "install"])
+def test_phase_tests_failure_is_fatal_by_default(monkeypatch, phase):
+    """A test callback that raises aborts the installation unless failures are allowed."""
+    tester = _phase_tester(monkeypatch)
+    builder = _phase_builder(_failing_check, allow_test_failures=False)
+    with pytest.raises(spack.util.executable.ProcessError):
+        tester.phase_tests(builder, phase, ["check"])
+
+
+@pytest.mark.parametrize("phase", ["build", "install"])
+def test_phase_tests_failure_allowed(monkeypatch, capfd, phase):
+    """With allow_test_failures, a raising test callback becomes a warning."""
+    tester = _phase_tester(monkeypatch)
+    builder = _phase_builder(_failing_check, allow_test_failures=True)
+    tester.phase_tests(builder, phase, ["check"])
+    assert len(tester.test_failures) == 1
+    assert "make test" in str(tester.test_failures[0][0])
+    err = capfd.readouterr().err
+    assert f"Ignoring {phase}-time test failures" in err
+    assert "/path/to/test-log.txt" in err
+
+
+def test_phase_tests_collected_failures_allowed(monkeypatch):
+    """Failures recorded via add_failure do not raise when allow_test_failures is set."""
+    tester = _phase_tester(monkeypatch)
+    builder = _phase_builder(lambda: tester.add_failure(RuntimeError("boom"), "failed"), True)
+    tester.phase_tests(builder, "install", ["check"])
+    assert len(tester.test_failures) == 1
+
+    tester = _phase_tester(monkeypatch)
+    builder = _phase_builder(lambda: tester.add_failure(RuntimeError("boom"), "failed"), False)
+    with pytest.raises(spack.install_test.TestFailure):
+        tester.phase_tests(builder, "install", ["check"])
+
+
+def test_phase_tests_stop_phase_is_not_swallowed(monkeypatch):
+    tester = _phase_tester(monkeypatch)
+
+    def stop():
+        raise spack.error.StopPhase("stop")
+
+    builder = _phase_builder(stop, allow_test_failures=True)
+    with pytest.raises(spack.error.StopPhase):
+        tester.phase_tests(builder, "build", ["check"])
