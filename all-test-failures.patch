+@pytest.mark.not_on_windows("POSIX pipes")
+@pytest.mark.parametrize("allow", [True, False])
+def test_ignored_test_failures_reach_parent(allow):
+    """A build process reports tolerated test failures to the parent, which collects them."""
+    from multiprocessing import Pipe
+    from types import SimpleNamespace
+    from unittest import mock
+
+    from spack.new_installer import send_ignored_test_failures
+    from spack.new_installer_posix import make_state_stream
+
+    pkg = mock.Mock(run_tests=True, allow_test_failures=allow)
+    pkg.spec.cformat.return_value = "fmt@12.2.0"
+    pkg.tester.test_failures = [(RuntimeError("boom"), "failed")]
+    pkg.tester.test_log_file = "/path/to/test-log.txt"
+
+    state_r, state_w = Pipe(duplex=False)
+    stream = make_state_stream(state_w)
+    send_ignored_test_failures(pkg, stream)
+    stream.flush()
+
+    installer = PackageInstaller.__new__(PackageInstaller)
+    installer.state_buffers = {}
+    installer.build_warnings = []
+    child = SimpleNamespace(state_r_conn=state_r, proc=SimpleNamespace(pid=1), spec=mock.Mock())
+    if allow:
+        installer._handle_child_state(child, mock.Mock())
+        assert len(installer.build_warnings) == 1
+        assert "fmt@12.2.0: 1 test failure(s) ignored" in installer.build_warnings[0]
+        assert "/path/to/test-log.txt" in installer.build_warnings[0]
+    else:
+        # nothing was written, so there is nothing to read
+        state_w.close()
+        installer._handle_child_state(child, mock.Mock())
+        assert installer.build_warnings == []
